# URL pública da API; vazia usa o proxy local do Vite.
VITE_API_BASE_URL=
# Origem HTTPS pública do frontend usada nos QR Codes permanentes dos setores.
# Obrigatória para gerar, baixar ou imprimir QR Codes. Ex.: https://avaliacoes.seuhospital.org.br
VITE_PUBLIC_APP_URL=
# Apenas para desenvolvimento local; não inclua segredos neste arquivo.
VITE_API_PROXY_TARGET=http://localhost:3000
# Trace local da pesquisa pública (somente em desenvolvimento).
VITE_PUBLIC_SURVEY_TRACE=false
